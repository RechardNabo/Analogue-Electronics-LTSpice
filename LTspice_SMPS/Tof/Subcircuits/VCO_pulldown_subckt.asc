TEXT -744 624 Left 2 !*\n.model DTOF2 D(TT=10n Rs=10m Cjo=10p Vfwd=1m Vrev=2)\n.model VCOSW SW(Ron=10 Roff=100Meg Vt=2 Vh=1)\n*\n*
TEXT -832 -600 Left 2 !*\n.param VFBmax=5 ; this is the maximum feedback voltage to get Fswmax\n*\n.param Ct=10p\n.param Vswing=2.008 ; Timing capacitor final swing\n.param IFMIN={Ct*Vswing/((1/Fswmin)-DT)} ; charging current when VFB = 0 V\n.param IDT={-(IFMIN-Ct*Vswing/DT)/5}\n.param G2={-(IFMIN+Ct*Vswing/(DT-(1/Fswmax)))/VFBmax}\n*
TEXT 304 -520 Left 2 ;Parameters to be passed are:\n \nFswmin=120k ; the LLC network will see half this value\nFswmax=500k ; the LLC network will see half this value\nDT=10n ; this is the dead time value\nPullup=20k ; this is the internal pull-up resistance
