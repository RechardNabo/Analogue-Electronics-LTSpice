TEXT -2264 -88 Left 2 !.tran 0 10m 5m 10n uic
TEXT -1456 160 Left 2 !.MODEL TOFSW2 SW(Ron=10m Roff=100Meg Vt=2 Vh=1)\n.MODEL DTOF D(IS=10e-18 RS=16m CJO=50p N=100m)
TEXT -2272 120 Left 2 !*\n.param Vin=400\n*\n* LLC controller parameters\n*\n.param DT=120n ; deadtime for the MOSFETs\n.param Fswmin=120k\n.param Fswmax=500k\n.param VDRV=12\n.param Rpullup=20k\n*
TEXT -1448 256 Left 2 !.options abstol=1u vntol=1m reltol=0.01 gmin=100p\n+method=gear
TEXT 792 -776 Left 2 !*\n.param Gfc=-1 ; magnitude at crossover\n.param PS=-80 ; phase lag at crossover\n*\n \n*\n* Enter Design Goals Information Here *\n*\n.param fc=2k ; targeted crossover\n.param PM=70 ; choose phase margin at crossover\n*\n* Pole-zero calculations *\n*\n.param boost=PM-PS-90\n.param fp={(tan(boost*pi/180)+sqrt((tan(boost*pi/180))**2+1))*fc}\n.param fz={fc**2/fp}\n*\n* Enter the Values for Vout and Bridge Bias Current *\n*\n.param Vout=24\n.param Ibias=2m\n.param Vref=2.5\n.param Rlower={Vref/Ibias}\n.param Rupper={(Vout-Vref)/Ibias}\n*\n* Optocoupler specifications *\n*\n.param Fopto=15k\n.param Copto={1/(2*pi*Fopto*Rpullup)}\n.param CTR=0.85\n*\n.param VL=2.5\n.param VCEsat=0.3\n.param Vdd=5 ; internal pullup voltage in the IC\n.param Ib=1m ; bias current for the TL431\n.param Vf=1\n.param A={Vout-Vf-VL}\n.param B={Vdd-VCEsat+Ib*CTR*Rpullup}\n.param Rmax={(A/B)*Rpullup*CTR}\n*\n* Do not edit the below lines *\n*\n.param G={10**(-Gfc/20)}\n.param RLED={CTR*Rpullup/G}\n.param C1={1/(2*pi*fz*Rupper)}\n.param C2={1/(2*pi*fp*Rpullup)}\n.param Ccol={C2-Copto}\n*\n*
TEXT -2264 -32 Left 2 !* Bootstrap specs *\n.param UVLOH=10 ; turn-on level\n.param UVLOL=8 ; turn-off level\n.param Icc=1m ; static driver consumption\n*
TEXT -1464 -32 Left 2 !.param P=250 ; nominal output power\n.param step=50 ; if step=30, then load is first 70% then goes 100%\n.param RL1={Vout**2/(P*(1-step/100))} ; first load\n.param RL2={Vout**2/(P*(step/100))} ; final load\n.param Rload={Vout**2/P} ; nominal 100% load
