TEXT -496 -184 Left 2 !*\n.model DBUCK D TT=10n Rs=10m Cjo=120p N=0.6 BV=150\n.model TOFSW SW (Ron=10m Roff=10Meg Vt=2 Vh=1)\n*
TEXT 1272 -160 Left 2 !*\n.param Gfc=-22 ; magnitude at crossover *\n.param PS=-120 ; phase lag at crossover *\n*\n* Enter Design Goals Information Here *\n*\n.param fc=10k ; targeted crossover *\n.param PM=60 ; choose phase margin at crossover *\n*\n* Capture the double zero position and \n* one of the pole position\n*\n.param fz1=600\n.param fz2=900\n.param fp2=50k ; this pole is usually placed at Fsw/2\n*\n* Enter the Values for Vout and Bridge Bias Current *\n*\n.param Vout=12\n.param Ibias=1m\n*\n* Do not edit the below lines *\n*\n.param Rlower={Vref/Ibias}\n.param Rupper={(Vout-Vref)/Ibias}\n.param boost={PM-PS-90}\n.param G={10**(-Gfc/20)}\n.param fp1={fc/tan(atan(fc/fz1)+atan(fc/fz2)-atan(fc/fp2)-boost*pi/180)}\n.param a={sqrt((fc**2/fp1**2)+1)}\n.param b={sqrt((fc**2/fp2**2)+1)}\n.param c={sqrt((fz1**2/fc**2)+1)}\n.param d={sqrt((fc**2/fz2**2)+1)}\n.param R2={((a*b/(c*d))/(fp1-fz1))*Rupper*G*fp1}\n.param C1={1/(2*pi*fz1*R2)}\n.param C2={C1/(C1*R2*2*pi*fp1-1)}\n.param C3={(fp2-fz2)/(2*pi*Rupper*fp2*fz2)}\n.param R3={Rupper*fz2/(fp2-fz2)}\n.param G0={((R2*C1)/(Rupper*(C1+C2)))*c*d/(a*b)}\n*\n* Internal PWM Model specifications\n*\n.param AOL=90 ; open-loop gain \n.param GAIN={10**(AOL/20)}\n.param pole=30 ; low-frequency pole\n.param Isink=20m ; sink capability\n.param Isource=500u ; source capability\n.param VOL=100m ; low-level voltage\n.param VOH=3 ; high-level voltage\n*\n.param Vv=0\n.param Vp=2 ; sawtooth amplitude\n.param Vref=2.5 ; internal voltage reference\n.param Tss=1m ; internal soft-start duration\n*\n*
TEXT -272 616 Left 2 !.tran 0 4.1m 4m 100n uic
TEXT -272 656 Left 2 !.options abstol=1u vntol=1m reltol=0.01 gmin=100p\n+method=gear
TEXT -384 1104 Left 2 ;The dc labels are the values of the components:\npV --> pF\nnV --> nF\nkV --> kOhms
TEXT 1968 -144 Left 2 !*\n.param Fsw=100k ; switching frequency\n.param Tsw={1/Fsw}\n.param Dutymax=0.45 ; max duty ratio\n.param DT=50n ; deadtime between Q and Qb\n.param VDRV=12 ; drive output voltage\n.param Imax=500m ; current sense limit\n*
