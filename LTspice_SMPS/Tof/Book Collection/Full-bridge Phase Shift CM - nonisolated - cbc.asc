TEXT 904 488 Left 2 !*\n.model DBUCK D TT=10n Rs=10m Cjo=120p N=0.6 BV=500\n.model TOFSW SW (Ron=10m Roff=10Meg Vt=2 Vh=1)\n*
TEXT -232 680 Left 2 !.tran 0 3m 2.95m uic
TEXT -232 752 Left 2 !.options abstol=1u vntol=1m reltol=0.01 gmin=100p\n+method=gear
TEXT -864 136 Left 2 !*\n.param Fsw=500k\n.param Tsw={1/Fsw}\n.param VDRV=12 ; DRV output\n\n*
TEXT -168 1144 Left 2 ;The dc labels are the values of the components:\npV --> pF\nnV --> nF\nkV --> kOhms\n*\nSlopes are in V/s\nSe is determined for a Q of 1\nIf Smag>Se, no need for slope comp\nIf Smag<Se, add missing slope to match Se
TEXT -864 -272 Left 2 !* \n.param AOL=90\n.param GAIN={10**(AOL/20)}\n.param pole=30\n.param Isink=20m\n.param Isource=500u\n.param VOL=100m\n.param VOH=5\n*\n.param Vref=2.5\n.param Tss=1m ; soft-start time\n.param DT=50n ; dead time between switches\n.param VCS=500m ; maximum sense voltage\n*
TEXT 2016 -360 Left 2 !*\n.param Vin=240\n.param Vout=12\n.param Pout=288\n.param L=3.47u\n.param Lr=15.3u\n.param Lmag=10m\n.param N={1/6}\n.param Rload={Vout**2/Pout}\n.param Iout={Vout/Rload}\n*\n.param NCT=200\n.param Rb=8\n.param Ri={Rb/NCT}\n*\n*\n.param Sramp={2.5/Tsw} ; 2.5 V over Ts - check your IC specs\n.param DeltaD={Lr*(Vout**2-N*Vin*Vout+2*Fsw*Iout*L*N*Vin)/(Vin*(L*Vin-Lr*N*Vout))}\n; DeltaD is the delay after which pulses appear the diodes anodes\n.param D={Vout/(N*Vin)} ; full-bridge duty ratio calculation\n.param Deff={D-DeltaD} ; effective duty-ratio applied on at the diodes cathodes\n.param Smag={Vin*Ri/Lmag} ; natural forward slope\n.param Sn={(((N*Vin-Vout)/L)*N)*Ri} ; secondary slope at the primary\n.param Se={Sn*(0.818/(1-Deff)-1)}\n.param S1=If(Smag>Se,0,Se-Smag)\n.param Rr={(S1/Sramp)*19k+100} ; Rr=100 ohms for 0 compensation\n*\n.param Gfc=-35 ; magnitude at crossover\n.param PS=-65 ; phase lag at crossover\n*\n* Enter Design Goals Information Here *\n*\n.param fc=4k ; targeted crossover\n.param PM=60 ; choose phase margin at crossover\n*\n* Enter the Values for Vout and Bridge Bias Current *\n*\n.param Ibias=1m\n.param Rlower={Vref/Ibias}\n.param Rupper={(Vout-Vref)/Ibias}\n*\n* Do not edit the below lines *\n*\n.param boost={PM-PS-90}\n.param G={10**(-Gfc/20)}\n.param fp={(tan(boost*pi/180)+sqrt((tan(boost*pi/180))**2+1))*fc}\n.param fz={fc**2/fp}\n.param a={sqrt((fc**2/fp**2)+1)}\n.param b={sqrt((fz**2/fc**2)+1)}\n.param R2={((a/b)*G*Rupper*fp)/(fp-fz)}\n.param C1={1/(2*pi*R2*fz)}\n.param C2={C1/(C1*R2*2*pi*fp-1)}\n*
