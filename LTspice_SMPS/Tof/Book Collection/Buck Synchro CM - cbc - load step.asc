TEXT -760 1056 Left 2 !*\n.model DBUCK D TT=10n Rs=10m Cjo=120p N=0.6 BV=150\n.model TOFSW SW (Ron=25m Roff=10Meg Vt=2 Vh=1)\n*
TEXT -760 968 Left 2 !.tran 0 3m 1.5m 100n uic
TEXT 1400 208 Left 2 !*\n.param Vin=12\n.param Vout=5\n.param L=100u\n.param Ri=160m\n.param Ts=10u ; please update clock and ramp generators *\n*\n.param Gfc=-24 ; magnitude at crossover\n.param PS=-70 ; phase lag at crossover\n*\n* Enter Design Goals Information Here *\n*\n.param fc=10k ; targeted crossover\n.param PM=70 ; choose phase margin at crossover\n*\n.param Sramp={2.5/Tsw} ; 2.5 V over Ts - check your IC specs\n.param D={Vout/Vin} ; duty ratio calculation in CCM\n.param Sn={(Vin-Vout)*Ri/L} ; current slope\n.param Se={Sn*(0.818/(1-D)-1)} ; external compensation for a Q of 1\n.param Rr={(Se/Sramp)*19k+100} ; Rr=100 ohms for 0 compensation\n*\n* Enter the Values for Vout and Bridge Bias Current *\n*\n.param Ibias=1m\n.param Rlower={Vref/Ibias}\n.param Rupper={(Vout-Vref)/Ibias}\n*\n* Do not edit the below lines *\n*\n.param boost={PM-PS-90}\n.param G={10**(-Gfc/20)}\n.param fp={(tan(boost*pi/180)+sqrt((tan(boost*pi/180))**2+1))*fc}\n.param fz={fc**2/fp}\n.param a={sqrt((fc**2/fp**2)+1)}\n.param b={sqrt((fz**2/fc**2)+1)}\n.param R2={((a/b)*G*Rupper*fp)/(fp-fz)}\n.param C1={1/(2*pi*R2*fz)}\n.param C2={C1/(C1*R2*2*pi*fp-1)}\n*
TEXT -760 1296 Left 2 ;The dc labels are the values of the components:\npV --> pF\nnV --> nF\nkV --> kOhms\n*\nSlopes are in V/s\nSe is determined for a Q of 1\nIf Smag>Se, no need for slope comp\nIf Smag<Se, add missing slope to match Se
TEXT -768 536 Left 2 !*\n.param Fsw=100k\n.param Tsw={1/Fsw}\n.param Dutymax=0.9 ; maximum duty ratio\n.param DT=50n ; deadtime between outputs\n.param VDRV=12 ; DRV output\n.param VCS=1 ; max Vsense\n*
TEXT -768 -16 Left 2 !*\n.param P=25\n.param step=50 ; if step=30, then load is first 70% then goes 100%\n.param RL1={Vout**2/(P*(1-step/100))} ; first load\n.param RL2={Vout**2/(P*(step/100))} ; final load\n.param Rload={Vout**2/P} ; nominal 100% load\n*\n* \n.param AOL=90\n.param GAIN={10**(AOL/20)}\n.param pole=30\n.param Isink=20m\n.param Isource=500u\n.param VOL=100m\n.param VOH=3\n*\n.param Vref=2.5\n.param Tss=1m\n*
