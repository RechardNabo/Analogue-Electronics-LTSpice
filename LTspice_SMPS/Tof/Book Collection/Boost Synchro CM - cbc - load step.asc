TEXT -624 992 Left 2 !*\n.model DBOOST D TT=10n Rs=10m Cjo=120p N=0.6 BV=150\n.model TOFSW SW (Ron=25m Roff=10Meg Vt=2 Vh=1)\n*
TEXT -608 800 Left 2 !.tran 0 7m 4.7m uic
TEXT 1336 232 Left 2 !*\n.param Vin=8\n.param Vout=15\n.param L=47u\n.param Ri=100m\n.param Ts=10u ; please update clock and ramp generators *\n*\n.param Gfc=-4 ; magnitude at crossover\n.param PS=-88 ; phase lag at crossover\n*\n* Enter Design Goals Information Here *\n*\n.param fc=2k ; targeted crossover\n.param PM=60 ; choose phase margin at crossover\n*\n.param Sramp={2.5/Tsw} ; 2.5 V over Ts - check your IC specs\n.param D={1-(Vin/Vout)} ; duty ratio calculation in CCM\n.param Sn={Vin*Ri/L} ; current on-slope\n.param Se={Sn*(0.818/(1-D)-1)} ; external compensation for a Q of 1\n.param Rr={(Se/Sramp)*19k+100} ; Rr=100 ohms for 0 compensation\n*\n* Enter the Values for Vout and Bridge Bias Current *\n*\n.param Ibias=1m\n.param Rlower={Vref/Ibias}\n.param Rupper={(Vout-Vref)/Ibias}\n*\n* Do not edit the below lines *\n*\n.param boost={PM-PS-90}\n.param G={10**(-Gfc/20)}\n.param fp={(tan(boost*pi/180)+sqrt((tan(boost*pi/180))**2+1))*fc}\n.param fz={fc**2/fp}\n.param a={sqrt((fc**2/fp**2)+1)}\n.param b={sqrt((fz**2/fc**2)+1)}\n.param R2={((a/b)*G*Rupper*fp)/(fp-fz)}\n.param C1={1/(2*pi*R2*fz)}\n.param C2={C1/(C1*R2*2*pi*fp-1)}\n*
TEXT -520 1432 Left 2 ;The dc labels are the values of the components:\npV --> pF\nnV --> nF\nkV --> kOhms\n*\nSlopes are in V/s\nSe is determined for a Q of 1\nIf Smag>Se, no need for slope comp\nIf Smag<Se, add missing slope to match Se
TEXT -616 552 Left 2 !*\n.param Fsw=100k\n.param Tsw={1/Fsw}\n.param Dutymax=0.9 ; maximum duty ratio\n.param DT=150n ; deadtime between outputs\n.param VDRV=12 ; DRV output\n.param VCS=1 ; max Vsense\n*
TEXT -616 200 Left 2 !* \n.param AOL=90\n.param GAIN={10**(AOL/20)}\n.param pole=30\n.param Isink=20m\n.param Isource=500u\n.param VOL=100m\n.param VOH=3\n*\n.param Vref=2.5\n.param Tss=1m\n*
TEXT 1336 1376 Left 2 !*\n.param P=15\n.param step=30 ; if step=30, then load is first 70% then goes 100%\n.param RL1={Vout**2/(P*(1-step/100))} ; first load\n.param RL2={Vout**2/(P*(step/100))} ; final load\n*
