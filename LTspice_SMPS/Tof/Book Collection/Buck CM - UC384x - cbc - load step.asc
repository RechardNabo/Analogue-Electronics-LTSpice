TEXT -688 -128 Left 2 !.tran 0 5.9m 4.7m 100n uic
TEXT -680 896 Left 2 !.options abstol=1u vntol=1m reltol=0.01 gmin=100p\n+method=gear
TEXT -680 992 Left 2 !*\n.param P=25\n.param step=60 ; if step=30, then load is first 70% then goes 100%\n.param RL1={Vout**2/(P*(1-step/100))} ; first load\n.param RL2={Vout**2/(P*(step/100))} ; final load\n.model TOFSW SW (Ron=25m Roff=10Meg Vt=2 Vh=1)\n*
TEXT 544 -504 Left 2 !*\n.param Vin=12\n.param Vout=5\n.param L=22u\n.param Rb=14\n.param Ri=Rb/100 ; this is R7 / turns ratio of Ct (1:100)\n.param Tsw=10u ;\n*\n.param Gfc=-26 ; magnitude at crossover\n.param PS=-74 ; phase lag at crossover\n*\n* Enter Design Goals Information Here *\n*\n.param fc=10k ; targeted crossover\n.param PM=60 ; choose phase margin at crossover\n*\n.param D={Vout/Vin} ; duty ratio calculation in CCM\n.param Sn={(Vin-Vout)*Ri/L} ; current slope\n.param Sea={Sn*(0.818/(1-D)-1)} ; external compensation for a Q of 1\n*\n* Enter the Values for Vout and Bridge Bias Current *\n*\n.param Ibias=1m\n.param Vref=2.5 ; internal reference voltage of the UC\n.param Rlower={Vref/Ibias}\n.param Rupper={(Vout-Vref)/Ibias}\n*\n* Do not edit the below lines *\n*\n.param boost={PM-PS-90}\n.param G={10**(-Gfc/20)}\n.param fp={(tan(boost*pi/180)+sqrt((tan(boost*pi/180))**2+1))*fc}\n.param fz={fc**2/fp}\n.param a={sqrt((fc**2/fp**2)+1)}\n.param b={sqrt((fz**2/fc**2)+1)}\n.param R2={((a/b)*G*Rupper*fp)/(fp-fz)}\n.param C1={1/(2*pi*R2*fz)}\n.param C2={C1/(C1*R2*2*pi*fp-1)}\n*\n* Current sense CT magnetizing slope\n*\n* The current sense mag current affects the on-time current\n* slope and must be compensated by increasing the external\n* ramp level. This is what is done here via Sm which supplements\n* the original compensation ramp calculated with Sea\n* See slide 149 of https://powersimtof.com/Downloads/PPTs/Chris%20Basso%20APEC%20seminar%202019.pdf\n*\n.param Lm=1.8m\n.param Vf=0.65\n.param VCS=1 ; maximum current sense voltage\n.param Sm={(Vf+VCS)*Rb/Lm} ; CT's magnetizing slope\n.param Se={Sea+Sm} ;\n*\n* Ramp Generator Calculation\n*\n.param Vcc=Vin ; The Vcc is the supply voltage and the peak DRV\n.param Rramp=19k ; Ramp injection resistance\n.param Ichg=3m ; Ramp charge current\n.param Rchg={Vcc/Ichg}\n.param Sr=300k ; create a slope of 300 mV/µs\n.param ton={D*Tsw}\n.param Cramp={(1+sqrt(1-(4*Sr*ton*(Rchg+Rramp)/(Rramp*Vcc))))*Vcc/(2*Rchg*Sr)}\n.param RCS={Rramp*Se/Sr}\n*
