TEXT -184 -256 Left 2 !*\n.model DBUCK D TT=10n Rs=10m Cjo=120p N=0.6 BV=150\n.model TOFSW SW (Ron=25m Roff=10Meg Vt=2 Vh=1)\n.model DCLP D TT=100n Rs=100m Cjo=50p N=0.6\n*
TEXT -1088 -152 Left 2 !*\n.param Vin=48\n.param Vout=42\n.param Iout=30 ; CC setpoint\n.param RL={(Vout/Iout)*0.5} ; adjust the coeff to move Vout at const. current.\n.param L=15u\n.param Ri=16m ; sense resistance for the buck\n.param Ts=10u ; please update clock and ramp generators\n.param Rsense=10m ; shunt resistance for measuring Iout\n.param Vref=100m ; sense voltage for the CC operation\n.param Rb=10k\n.param Ra={Iout*Rsense*Rb/Vref}\n*\n* Extract data from Mag and Phase graph, power stages \n*\n.param GfcV=13 ; magnitude at crossover *\n.param PSV=-83 ; phase lag at crossover *\n*\n*\n.param GfcI=-14 ; magnitude at crossover *\n.param PSI=-45 ; phase lag at crossover *\n*\n* Enter Design Goals Information Loop V Here *\n*\n.param fcV=1k ; targeted crossover *\n.param PMV=70 ; choose phase margin at crossover *\n*\n* Enter Design Goals Information Loop I Here *\n*\n.param fcI=400 ; targeted crossover *\n.param PMI=60 ; choose phase margin at crossover *\n*\n*\n.param Sn={((Vin-Vout)/L)*Ri}\n.param Sramp={1/Ts}\n.param mc=3 ; set this value for slope comp *\n.param Se={(mc-1)*Sn}\n.param kr={Se/Sramp}\n*\n* Enter the Values for Vout and Bridge Bias Current *\n*\n.param Ibias=1m\n.param Rlower={Vref/Ibias}\n.param RupperV={(Vout-Vref)/Ibias}\n.param RupperI=22k\n*\n* Do not edit the below lines - V loop compensation *\n.param boostV={PMV-PSV-90}\n.param GV={10**(-GfcV/20)}\n.param fpV={(tan(boostV*pi/180)+sqrt((tan(boostV*pi/180))**2+1))*fcV}\n.param fzV={fcV**2/fpV}\n.param a={sqrt((fcV**2/fpV**2)+1)}\n.param b={sqrt((fzV**2/fcV**2)+1)}\n.param R2V={((a/b)*GV*RupperV*fpV)/(fpV-fzV)}\n.param C1V={1/(2*pi*R2V*fzV)}\n.param C2V={C1V/(C1V*R2V*2*pi*fpV-1)}\n*\n* Do not edit the below lines - I loop compensation *\n.param GIRes={Rb/(Ra+Rb)}\n.param boostI={PMI-PSI-90}\n.param GI={(10**(-GfcI/20))/GIRes}\n.param fpI={(tan(boostI*pi/180)+sqrt((tan(boostI*pi/180))**2+1))*fcI}\n.param fzI={fcI**2/fpI}\n.param aa={sqrt((fcI**2/fpI**2)+1)}\n.param bb={sqrt((fzI**2/fcI**2)+1)}\n.param R2I={((aa/bb)*GI*RupperI*fpI)/(fpI-fzI)}\n.param C1I={1/(2*pi*R2I*fzI)}\n.param C2I={C1I/(C1I*R2I*2*pi*fpI-1)}\n*
TEXT -112 1296 Left 2 !.tran 0 6.2m 6m 100n uic
TEXT 1280 1216 Left 2 !*\n* Choose op amp characteristics *\n*\n.param AOL=90 ; open-loop gain in dB *\n.param POLE=30 ; low-frequency pole *\n.param VHIGH=5 ; upper output level *\n.param VLOW=100m ; lower output level *\n*\n* Do not edit these lines *\n*\n.param GAIN={10**(AOL/20)}\n.param COL={1/(6.28*(GAIN/100u)*POLE)}\n.param ROL={GAIN/100u}\n*
TEXT -112 1336 Left 2 !.options abstol=1u vntol=1m reltol=0.01 gmin=100p\n+method=gear
