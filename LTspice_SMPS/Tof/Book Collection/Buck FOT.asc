TEXT -448 -176 Left 2 !*\n.model DBUCK D TT=10n Rs=10m Cjo=120p N=0.6 BV=150\n.model TOFSW SW (Ron=25m Roff=10Meg Vt=2 Vh=1)\n.model TOFSWC SW (Ron=10 Roff=100Meg Vt=2 Vh=1)\n*
TEXT 368 -144 Left 2 !*\n.param toff=2u ; constant off-time value\n.param VCS=2 ; max Vsense\n.param Ct={10u*toff/1}\n*
TEXT 1032 -104 Left 2 !*\n.param Vin=10\n.param Vout=5\n.param L=2u\n.param Ri=100m\n*\n.param Gfc=-26 ; magnitude at crossover\n.param PS=-90 ; phase lag at crossover\n*\n* Enter Design Goals Information Here *\n*\n.param fc=15k ; targeted crossover\n.param PM=60 ; choose phase margin at crossover\n*\n* Enter the Values for Vout and Bridge Bias Current *\n*\n.param Vref=2.5\n.param Ibias=1m\n.param Rlower={Vref/Ibias}\n.param Rupper={(Vout-Vref)/Ibias}\n*\n* Do not edit the below lines *\n*\n.param boost={PM-PS-90}\n.param G={10**(-Gfc/20)}\n.param fp={(tan(boost*pi/180)+sqrt((tan(boost*pi/180))**2+1))*fc}\n.param fz={fc**2/fp}\n.param a={sqrt((fc**2/fp**2)+1)}\n.param b={sqrt((fz**2/fc**2)+1)}\n.param R2={((a/b)*G*Rupper*fp)/(fp-fz)}\n.param C1={1/(2*pi*R2*fz)}\n.param C2={C1/(C1*R2*2*pi*fp-1)}\n*\n* Choose op amp characteristics *\n*\n.param AOL=90 ; open-loop gain in dB *\n.param POLE=30 ; low-frequency pole *\n.param VHIGH=5 ; upper output level *\n.param VLOW=100m ; lower output level *\n*\n* Do not edit these lines *\n*\n.param GAIN={10**(AOL/20)}\n.param COL={1/(6.28*(GAIN/100u)*POLE)}\n.param ROL={GAIN/100u}\n*
TEXT -472 992 Left 2 !.options abstol=1u vntol=1m reltol=0.01 gmin=100p\n+method=gear\n.options logparams
TEXT -472 1088 Left 2 !.tran 0 1.05m 1m 50n
