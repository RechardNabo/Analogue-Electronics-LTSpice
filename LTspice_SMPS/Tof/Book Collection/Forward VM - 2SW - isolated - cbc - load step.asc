TEXT -552 1056 Left 2 !*\n.model DBUCK D TT=10n Rs=10m Cjo=120p N=0.6 BV=150\n.model TOFSW SW (Ron=10m Roff=10Meg Vt=2 Vh=1)\n*
TEXT 1408 -96 Left 2 !*\n.param Vin=36\n.param Vout=12\n.param P=150 ; nominal output power\n.param step=30 ; if step=30, then load is first 70% then goes 100%\n.param RL1={Vout**2/(P*(1-step/100))} ; first load\n.param RL2={Vout**2/(P*(step/100))} ; final load\n.param Rload={Vout**2/P} ; nominal 100% load\n \n.param L=25u\n.param Ri=40m\n*\n.param Gfc=-13 ; magnitude at crossover\n.param PS=-140 ; phase lag at crossover\n*\n* Enter Design Goals Information Here *\n*\n.param fc=10k ; targeted crossover\n.param PM=60 ; choose phase margin at crossover\n*\n* Enter the Values for Vout and Bridge Bias Current *\n*\n.param Ibias=1m\n.param Vref2=2.5\n.param Rlower={Vref2/Ibias}\n.param Rupper={(Vout-Vref2)/Ibias}\n.param RLED=470\n.param Rpullup=4.7k\n.param Vdd=3\n*\n* Capture the double zero position and one of the pole position *\n*\n.param fz1=600\n.param fz2=900\n.param fp2=50k\n*\n* Do not edit the below lines *\n*\n.param boost={PM-PS-90}\n.param G={10**(-Gfc/20)}\n.param fp1={fc/tan(atan(fc/fz1)+atan(fc/fz2)-atan(fc/fp2)-boost*pi/180)}\n*\n * adjust second pole for targeted boost *\n*\n.param a={sqrt((fc**2/fp1**2)+1)}\n.param b={sqrt((fc**2/fp2**2)+1)}\n.param c={sqrt((fz1**2/fc**2)+1)}\n.param d={sqrt((fc**2/fz2**2)+1)}\n.param R2={((a*b/(c*d))/((fp1-fz1)*(Rpullup*CTR)))*Rupper*G*fp1*RLED}\n.param C1={1/(2*pi*fz1*R2)}\n.param C2={C1/(C1*R2*2*pi*fp1-1)}\n.param C3={(fp2-fz2)/(2*pi*Rupper*fp2*fz2)}\n.param R3={Rupper*fz2/(fp2-fz2)}\n.param G0={((R2*C1*Rpullup)/(Rupper*RLED*(C1+C2)))*c*d/(a*b)} ; Gain at fc sanity check\n*\n*\n* Choose op amp characteristics *\n*\n.param AOL2=90 ; open-loop gain in dB *\n.param POLE2=300 ; low-frequency pole *\n.param VHIGH=5 ; upper output level *\n.param VLOW=100m ; lower output level *\n*\n* Do not edit these lines *\n*\n.param GAIN2={10**(AOL2/20)}\n.param COL={1/(6.28*(GAIN2/100u)*POLE2)}\n.param ROL={GAIN/100u}\n*\n* Enter opto characteristics *\n*\n.param Fopto=15k\n.param Copto={1/(2*pi*Fopto*Rpullup)}\n.param CTR=1\n*
TEXT -568 632 Left 2 !.tran 0 15m 9.6m 100n uic
TEXT -568 688 Left 2 !.options abstol=1u vntol=1m reltol=0.01 gmin=100p\n+method=gear
TEXT 136 680 Left 2 ;The dc labels are the values of the components:\npV --> pF\nnV --> nF\nkV --> kOhms
TEXT 2192 -96 Left 2 !*\n.param Fsw=100k ; switching frequency\n.param Tsw={1/Fsw}\n.param Dutymax=0.45 ; max duty ratio\n.param DT=50n ; deadtime between Q and Qb\n.param VDRV=12 ; drive output voltage\n.param Imax=600m ; current sense limit\n*\n* Internal PWM Model specifications\n*\n.param AOL=90 ; open-loop gain \n.param GAIN={10**(AOL/20)}\n.param pole=30 ; low-frequency pole\n.param Isink=20m ; sink capability\n.param Isource=500u ; source capability\n.param VOL=100m ; low-level voltage\n.param VOH=5 ; high-level voltage\n*\n.param Vv=0\n.param Vp=2 ; sawtooth amplitude\n.param Vref=2.5 ; internal voltage reference\n.param Tss=10u ; internal soft-start duration\n*
