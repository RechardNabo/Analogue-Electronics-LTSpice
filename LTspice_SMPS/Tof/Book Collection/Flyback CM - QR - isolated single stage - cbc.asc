TEXT -992 -384 Left 2 !*\n.model DPFC D TT=100n Rs=10m Cjo=50p N=0.6\n.model DBUCK D TT=10n Rs=10m Cjo=120p N=0.6 BV=650\n.model TOFSW SW (Ron=100m Roff=10Meg Vt=2 Vh=1)\n.model DCLP D RS=10 VFWD=1m TT=10n\n*
TEXT -840 864 Left 2 !.tran 0 450m 400m uic\n;.op
TEXT -848 800 Left 2 !.options abstol=1u vntol=1m reltol=0.01 gmin=100p\n+method=gear
TEXT -504 1048 Left 2 ;* Run an operating point to obtain the dc labels (.op)\n* These dc labels are the values of the components:\npV --> pF\nnV --> nF\nkV --> kOhms\n*\nIf Ccol is negative, the opto pole is too low
TEXT 1456 -376 Left 2 !*\n.param Vrms=230\n.param Vout=12\n.param Lp=1m\n.param Ri=1\n.param N=84m\n.param Rload=7\n*
TEXT -1576 944 Left 2 !* \n.param AOL=90\n.param GAIN={10**(AOL/20)}\n.param pole=30\n.param Isink=20m\n.param Isource=500u\n.param VOL=100m\n.param VOH=5\n*\n.param Vref=2.5\n.param Tss=5m\n*
TEXT -1592 784 Left 2 !*\n.param Dutymax=0.8\n.param DT=50n\n.param VDRV=12\n.param VCS=1.4\n*
TEXT 1456 -144 Left 2 !*\n.param Gfc=20 ; magnitude at crossover *\n.param PS=-45 ; phase lag at crossover *\n*\n* Enter Design Goals Information Here *\n*\n.param fc=4 ; targeted crossover *\n.param PM=60 ; choose phase margin at crossover *\n*\n*\n* Enter the Values for Vout and Bridge Bias Current *\n*\n.param Ibias=250u\n.param Vref2=2.5\n*\n* Enter opto characteristics *\n*\n.param Rpullup=20k ; check with the selected control chip\n.param Fopto=6k\n.param Copto={1/(2*pi*Fopto*Rpullup)}\n.param CTR=0.33\n.param Rd=100 ; this is the LED dynamic resistance, depends on FB current\n*\n.param Vaux=12\n.param VL=2.5\n.param VCEsat=0.3\n.param Vdd=3.3\n.param Ib=1m\n.param Vf=1\n.param A={Vaux-Vf-VL}\n.param B={Vdd-VCEsat+Ib*CTR*Rpullup}\n.param Rmax={(A/B)*Rpullup*CTR}\n.param RLED={0.4*Rmax}\n*\n* Do not edit the below lines *\n*\n.param Rlower={Vref2/Ibias}\n.param Rupper={(Vout-Vref2)/Ibias}\n.param boost={PM-PS-90}\n.param kf={tan((boost/2+45)*pi/180)}\n.param G1={Rpullup*CTR/RLED}\n.param G2={10**(-Gfc/20)}\n.param G={G2/G1}\n.param fp={fc*kf}\n.param fz={fc/kf}\n.param d={(fz**2+fc**2)*(fp**2+fc**2)}\n.param c={(fz**2+fc**2)}\n.param R2={(sqrt(d)/c)*G*fc*Rupper/fp}\n.param C1={1/(2*pi*fz*R2)}\n.param C2={1/(2*pi*fp*Rpullup)}\n.param Ccol={C2-Copto}\n*
