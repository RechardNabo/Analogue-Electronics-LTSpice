TEXT 1232 192 Left 2 !*\n.PARAM Fline=50\n.PARAM Vgrms=230\n.PARAM Vgpeak={Vgrms*sqrt(2)}\n.PARAM Vamp={Vgpeak*2}\n.PARAM Ri=55m\n*\n.MODEL TOFSW SW(Ron=25m Roff=10Meg Vt=2 Vh=1)\n.MODEL TOFSWCT SW(Ron=100 Roff=100Meg Vt=2 Vh=1)\n.MODEL TOFD D(IS=10e-18 RS=16m CJO=550p \n+M=0.4 VJ=0.75 ISR=720n BV=1000 IBV=100u TT=130n)\n.MODEL DZTOF D(BV=2.1 RS=100m Cjo=100p)\n.MODEL DOTA D(Rs=1 TT=100n N=100m)\n*
TEXT 1240 48 Left 2 !.tran 0 400m 100m uic
TEXT 1232 104 Left 2 !.options abstol=1u vntol=1m reltol=0.01 gmin=100p\n+method=gear
TEXT 1976 -208 Left 2 !*\n.param Vout=800\n.param Pout=10k ; nominal is 5 kW\n.param RL={(Vout/2)**2/(Pout/2)}\n*\n.param Gfc=24 ; magnitude at crossover *\n.param PS=-85 ; phase lag at crossover *\n*\n* Enter Design Goals Information Here *\n*\n.param fc=40 ; targeted crossover *\n.param PM=70 ; choose phase margin at crossover *\n*\n*\n* Enter the Values for Vout and Bridge Bias Current *\n*\n.param Ibias=126u\n.param Vref=2.5\n*\n* Do not edit the below lines *\n*\n.param gm=110u ; transconductance in Siemens *\n.param Rlower={Vref/Ibias}\n.param Rupper={(Vout-Vref)/Ibias}\n.param boost={PM-PS-90}\n.param G={10**(-Gfc/20)}\n.param kf={tan((boost/2+45)*pi/180)}\n.param fp={fc*kf}\n.param fz={fc/kf}\n.param a={sqrt((fc**2/fp**2)+1)}\n.param b={sqrt((fz**2/fc**2)+1)}\n.param R2={(a/b)*(fp*G)*(Rlower+Rupper)/((fp-fz)*Rlower*gm)}\n.param C1={1/(2*pi*R2*fz)}\n.param C2={Rlower*gm*(b/a)/(2*pi*fp*G*(Rlower+Rupper))}\n*
TEXT 1416 1600 Left 2 ;The dc labels are the values of the components:\npV --> pF\nnV --> nF\nkV --> kOhms
TEXT 1240 720 Left 2 ;This is variable off-time PFC. Run an .op statement to see\nthe values automated by the macro.\n \nChristophe Basso - November 2024
