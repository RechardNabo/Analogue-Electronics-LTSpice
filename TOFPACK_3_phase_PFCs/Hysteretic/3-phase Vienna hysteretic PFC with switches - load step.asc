TEXT 2384 -680 Left 2 !*\n.PARAM Fline=50\n.param Vgrms=230\n.PARAM Vgpeak={Vgrms*sqrt(2)}\n.PARAM Vamp={Vgpeak*2}\n.PARAM Ri=60m ; current sense\n.PARAM VH=100m ; upper current threshold\n.PARAM VL={-VH} ; lower current threshold\n*\n.MODEL TOFSW SW(Ron=25m Roff=10Meg Vt=2 Vh=1)\n.model TOFD D(IS=23.367E-18 N=.9983 RS=77.399E-3 IKF=1.0000E3 CJO=453.20E-12 M=.44242\n+ VJ=1.3170 ISR=31.573E-9 NR=2.4162 TT=0 XTI=2 EG=3.26 FC=0.5)\n; STPSC10H12CWL\n*
TEXT 1880 -64 Left 2 !.tran 0 700m 250m uic
TEXT 2672 608 Left 2 !.param GfcV=50 ; magnitude at crossover *\n.param PSV=-62 ; phase lag at crossover *\n*\n* Enter Design Goals Information Here *\n*\n.param fcV=10 ; targeted crossover *\n.param PMV=60 ; choose phase margin at crossover *\n*\n* Enter the Values for Vout and Bridge Bias Current *\n*\n.param Vout=800\n.param Pout=20k\n.param RL={(Vout/2)**2/(Pout/2)}\n.param Ibias=100u\n.param Vref=2.5\n.param Rlower={Vref/Ibias}\n.param Rupper={(Vout-Vref)/Ibias}\n*\n* Do not edit the below lines *\n.param boostV={PMV-PSV-90}\n.param GV={10**(-GfcV/20)}\n.param kV={tan((boostV/2+45)*pi/180)}\n.param fpV={fcV*kV}\n.param fzV={fcV/kV}\n.param C2V={1/(2*pi*fcV*GV*kV*Rupper)}\n.param C1V={C2V*(kV**2-1)}\n.param R2V={kV/(C1V*2*pi*fcV)}\n*
TEXT 2384 -792 Left 2 !.four 50 10 -1 I(Via)\n.four 50 10 -1 I(Vib)\n.four 50 10 -1 I(Vic)
TEXT 2376 -880 Left 2 !.options abstol=1u vntol=1m reltol=0.01 gmin=100p\n+method=gear
TEXT 1120 456 Left 2 ;A. Chatterjee, R. Rastogi, A. Rastogi, Dr. Elangovan D, A Front End Vienna Rectifier with SPWM Inverter\nUsing dsPIC for Induction Motor Drive, 2019 Innovations in Power and Advanced Computing Technologies.
