TEXT 992 -120 Left 2 !.tran 0 200m 150m uic
TEXT 2760 -392 Left 2 !* Components for the d loop *\n.param Gfcd=40 ; magnitude at crossover *\n.param PSd=-110 ; phase lag at crossover *\n*\n* Enter Design Goals Information Here *\n*\n.param fcd=2k ; targeted crossover *\n.param PMd=60 ; choose phase margin at crossover *\n*\n* Enter the Values for Vout and Bridge Bias Current *\n*\n.param Rdd=100k\n*\n* Do not edit the below lines *\n.param boostd={PMd-PSd-90}\n.param Gd={10**(-Gfcd/20)}\n.param kd={tan((boostd/2+45)*pi/180)}\n.param fpd={fcd*kd}\n.param fzd={fcd/kd}\n.param C2d={1/(2*pi*fcd*Gd*kd*Rdd)}\n.param C1d={C2d*(kd**2-1)}\n.param R2d={kd/(C1d*2*pi*fcd)}\n*
TEXT 2760 -984 Left 2 !* Components for the q loop *\n.param Gfcq=40 ; magnitude at crossover *\n.param PSq=-110 ; phase lag at crossover *\n*\n* Enter Design Goals Information Here *\n*\n.param fcq=2k ; targeted crossover *\n.param PMq=60 ; choose phase margin at crossover *\n*\n.param Rdq=100k\n*\n* Do not edit the below lines *\n.param boostq={PMq-PSq-90}\n.param Gq={10**(-Gfcq/20)}\n.param kq={tan((boostq/2+45)*pi/180)}\n.param fpq={fcq*kq}\n.param fzq={fcq/kq}\n.param C2q={1/(2*pi*fcq*Gq*kq*Rdq)}\n.param C1q={C2d*(kq**2-1)}\n.param R2q={kq/(C1q*2*pi*fcq)}\n*
TEXT 1440 280 Left 2 !.four 50 10 -1 I(Via)\n.four 50 10 -1 I(Vib)\n.four 50 10 -1 I(Vic)
TEXT 984 0 Left 2 !.options abstol=1u vntol=1m reltol=0.01 gmin=1n\n+method=gear\n*\n.MODEL TOFSW SW(Ron=25m Roff=10Meg Vt=2 Vh=1)\n.model TOFD D(IS=23.367E-18 N=.9983 RS=77.399E-3 IKF=1.0000E3 CJO=453.20E-12 M=.44242\n+ VJ=1.3170 ISR=31.573E-9 NR=2.4162 TT=0 XTI=2 EG=3.26 FC=0.5)\n; STPSC10H12CWL\n*
TEXT 1632 -1064 Left 2 !*\n.PARAM Fline=50 ; network frequency\n.PARAM Tref={1/Fline}\n.PARAM Vgrms=110 ; per phase line-neutral voltage\n.PARAM Vdc=400 ; dc rail value\n*\n.PARAM Vgpeak={Vgrms*sqrt(2)}\n.PARAM Vamp={Vgpeak*2}\n*\n.PARAM PWinj=-20k ; power in watts, P means absorption, -P means injection\n.PARAM PQinj=10k  ; wanted VARs\n.PARAM RL={(Vgrms**2/PWinj)*3} ; equivalent load resistance per phase\n.PARAM Ri=0.1 ; current sense value per phase\n.PARAM KVin=0.1 ; voltage sense per phase\n.PARAM Fsw=30k ; switching frequency\n.PARAM Tsw={1/Fsw}\n.PARAM DT={150n}\n*\n.PARAM w={2*pi*Fline}\n.PARAM L=650u\n.PARAM t1=5m\n.PARAM theta=t1*Fline*2*pi ; angle in radians\n.PARAM Va={Vgpeak*sin(theta)} ; phase a voltage at time t1\n.PARAM Vb={Vgpeak*sin(theta-2*pi/3)} ; phase b voltage at time t1\n.PARAM Vc={Vgpeak*sin(theta-4*pi/3)} ; ; phase c voltage at time t1\n.PARAM ia={Va/RL} ; current at time t1 in phase a\n.PARAM ib={Vb/RL} ; current at time t1 in phase b\n.PARAM ic={Vc/RL} ; current at time t1 in phase c\n*\n.PARAM vd={sqrt(2/3)*(sin(theta)*Va+sin(theta-2*pi/3)*Vb+sin(theta+2*pi/3)*Vc)}\n.PARAM vq={sqrt(2/3)*(cos(theta)*Va+cos(theta-2*pi/3)*Vb+cos(theta+2*pi/3)*Vc)}\n.PARAM id={sqrt(2/3)*(sin(theta)*ia+sin(theta-2*pi/3)*ib+sin(theta+2*pi/3)*ic)}\n.PARAM iq={sqrt(2/3)*(cos(theta)*ia+cos(theta-2*pi/3)*ib+cos(theta+2*pi/3)*ic)}\n*\n.PARAM IdSET={(PWinj-id*vq)*Ri/vd} ; calculated setpoint [V] for the d value\n.PARAM IqSET={(id*vq-PQinj)*Ri/vd} ; calculated current setpoint [V] for the q value\n*
TEXT 1048 552 Left 2 ;d-q currents setpoints in V
