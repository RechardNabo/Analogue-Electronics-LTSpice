TEXT 1024 -200 Left 2 !*\n.param Vout=12 ; regulated output voltage\n*\n.param Ibias=250u\n.param Vref=2.5\n*\n* Do not edit the below lines *\n*\n.param Rlower={Vref/Ibias}\n.param Rupper={(Vout-Vref)/Ibias}\n.param kdiv={Rlower/(Rlower+Rupper)}\n*\n*\n.PARAM Gfc=20 ; magnitude at crossover\n.PARAM PS=-150 ; phase lag at crossover\n*\n* Enter Design Goals Information Here\n*\n.PARAM fc=10k ; targeted crossover\n.PARAM PM=70 ; choose phase margin at crossover\n*\n* Do not edit the below lines *\n.PARAM boost={PM-PS-90}\n.PARAM G1={10**(-Gfc/20)}\n.PARAM kf={(tan((boost/4+45)*pi/180))**2}\n*\n.PARAM fz1={fc/sqrt(kf)}\n.PARAM fz2={fc/sqrt(kf)}\n.PARAM fp1={fc*sqrt(kf)}\n.PARAM fp2={fc*sqrt(kf)}\n*\n.PARAM Fsw=200k ; sampling frequency\n.PARAM Tsw={1/Fsw} ; sampling period\n.PARAM Ts=Tsw\n*\n.PARAM G01={G1/sqrt(((fz1/fc)**2+1)*((fc/fz2)**2+1)/((1+(fc/fp1)**2)*(1+(fc/fp2)**2)))}\n.PARAM G0=G01/kdiv\n*\n.PARAM wz1={2*pi*fz1}\n.PARAM wp1={2*pi*fp1}\n.PARAM wz2={2*pi*fz2}\n.PARAM wp2={2*pi*fp2}\n*\n.PARAM a0={(G0*Tsw*wp1*wp2*(Tsw*wz1+2)*(Tsw*wz2+2))/(2*(4*wz2+2*Tsw*wp1*wz2+2*Tsw*wp2*wz2+Tsw**2*wp1*wp2*wz2))}\n.PARAM a1={(G0*Tsw*wp1*wp2*(2*Tsw*wz1+2*Tsw*wz2+3*Tsw**2*wz1*wz2-4))/(2*(4*wz2+2*Tsw*wp1*wz2+2*Tsw*wp2*wz2+Tsw**2*wp1*wp2*wz2))}\n.PARAM a2={(-G0*Tsw*wp1*wp2*(2*Tsw*wz1+2*Tsw*wz2-3*Tsw**2*wz1*wz2+4))/(2*(4*wz2+2*Tsw*wp1*wz2+2*Tsw*wp2*wz2+Tsw**2*wp1*wp2*wz2))}\n.PARAM a3={(G0*Tsw*wp1*wp2*(Tsw*wz1-2)*(Tsw*wz2-2))/(2*(4*wz2+2*Tsw*wp1*wz2+2*Tsw*wp2*wz2+Tsw**2*wp1*wp2*wz2))}\n.PARAM b1={((Tsw*wp2-2)/(Tsw*wp2+2))-4/(2+Tsw*wp1)}\n.PARAM b2={(16/((Tsw*wp1+2)*(Tsw*wp2+2)))-1}\n.PARAM b3={-(Tsw*wp1-2)*(Tsw*wp2-2)/((Tsw*wp1+2)*(Tsw*wp2+2))}\n*\n*
TEXT 472 424 Left 2 !.ac dec 1000 10 1Meg
